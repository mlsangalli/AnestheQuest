{
  "name": "anesthequest",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "packages/*",
    "web",
    "app"
  ],
  "scripts": {
    "web": "npm run dev --workspace @anesthequest/web",
    "web:build": "npm run build --workspace @anesthequest/web",
    "app": "npm run start --workspace @anesthequest/app",
    "app:web": "npm run web --workspace @anesthequest/app",
    "test": "npm run test --workspace @anesthequest/core",
    "core:test": "npm run test --workspace @anesthequest/core",
    "core:typecheck": "npm run typecheck --workspace @anesthequest/core",
    "db:start": "supabase start",
    "db:reset": "supabase db reset",
    "db:test": "supabase test db",
    "db:stop": "supabase stop",
    "gen:types": "supabase gen types typescript --local --schema public > packages/core/src/types/database.types.ts"
  },
  "devDependencies": {
    "typescript": "~5.8.3"
  },
  "overrides": {
    "react": "19.0.0",
    "react-dom": "19.0.0"
  }
}
