# =====================================================================
# AnestheQuest — variáveis de ambiente (template)
# =====================================================================
# Copie os blocos conforme o destino:
#   - app/.env          -> Expo (somente EXPO_PUBLIC_* vão ao cliente)
#   - web/.env.local    -> Next.js (NEXT_PUBLIC_* vão ao cliente)
#   - .env (raiz)       -> scripts/edge functions (Supabase CLI)
# NUNCA comite arquivos .env reais. NUNCA exponha a service-role key no cliente.

# ---------------------------------------------------------------------
# Supabase — cliente (app Expo)
# ---------------------------------------------------------------------
EXPO_PUBLIC_SUPABASE_URL=http://localhost:54321
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-local-anon-key

# ---------------------------------------------------------------------
# Supabase — cliente (web, quando o produto web usar o backend)
# ---------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=http://localhost:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-local-anon-key

# ---------------------------------------------------------------------
# Supabase — SERVIDOR (webhooks, scripts admin, edge functions)
# JAMAIS use no cliente.
# ---------------------------------------------------------------------
SUPABASE_URL=http://localhost:54321
SUPABASE_SERVICE_ROLE_KEY=your-local-service-role-key

# ---------------------------------------------------------------------
# Stripe — pagamentos web (Fase 1). Use chaves de teste.
# ---------------------------------------------------------------------
STRIPE_SECRET_KEY=sk_test_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx
STRIPE_PRICE_ANUAL=price_xxx
STRIPE_PRICE_RESIDENTE=price_xxx

# ---------------------------------------------------------------------
# RevenueCat — compras in-app mobile (gancho p/ fase mobile; não usado no MVP)
# ---------------------------------------------------------------------
# REVENUECAT_PUBLIC_SDK_KEY=
# REVENUECAT_WEBHOOK_AUTH=
